# ---------------------------------------------------------------------------
# Northstar Portfolio — single source of configuration
#
# Every service (Postgres, the Express API, and the Vite dev proxy) reads its
# settings from this one file. Copy it to `.env` to override anything:
#
#     cp .env.example .env
#
# The values below are the defaults already baked into docker-compose.yml, so
# the stack runs with no .env file at all — copying it is only needed if you
# want to change something (e.g. a port that is already taken on your machine).
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Used by the `db` container to initialise the cluster, and composed into
# DATABASE_URL for the API. Changing these on an existing volume has no effect
# until you reset it: docker compose down -v && docker compose up -d --build
POSTGRES_USER=northstar
POSTGRES_PASSWORD=northstar_dev
POSTGRES_DB=northstar

# Host port for Postgres. Change if 5432 is already in use locally.
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
# Port the Express server listens on, and the host port it is published to.
# The Vite dev server proxies /api to this port, so changing it here is picked
# up by the frontend automatically.
API_PORT=3001

# Secret used to sign JWTs. Dev-only placeholder — in a real deployment this
# would come from a secrets manager and never be committed anywhere.
JWT_SECRET=dev-secret-change-me

# --- Seeded accounts ------------------------------------------------------
# Two demo accounts are created on API startup by server/seed.js:
#
#   tenant_a@example.com  ->  Alpha Capital
#   tenant_b@example.com  ->  Beacon Advisors
#
# Both use the password below. It is hashed with bcrypt at seed time, so no
# password hash is ever stored in the repo. Change it here and restart the API
# (docker compose restart api) to re-seed with a new password.
SEED_PASSWORD=Password123!

# bcrypt work factor used for the seeded accounts.
BCRYPT_ROUNDS=10
